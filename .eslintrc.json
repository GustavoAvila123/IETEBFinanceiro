{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "firebase": "readonly",
    "Tesseract": "readonly",
    "pdfjsLib": "readonly",
    "XLSX": "readonly",
    "Chart": "readonly",
    "CHURCHES": "readonly",
    "MESES": "readonly",
    "DASH_COLORS": "readonly",
    "I18N_STRINGS": "readonly",
    "loadScript": "readonly",
    "escHtml": "readonly",
    "toTitleCase": "readonly",
    "truncate": "readonly",
    "setInput": "readonly",
    "onlyNumbers": "readonly",
    "clearFieldError": "readonly",
    "isoToDateInput": "readonly",
    "dateInputToISO": "readonly",
    "onDateInput": "readonly",
    "onDateBlur": "readonly",
    "parseBRL": "readonly",
    "formatBRL": "readonly",
    "maskCurrency": "readonly",
    "getCurrentUser": "readonly",
    "getEntradasData": "readonly",
    "getSaidasData": "readonly",
    "badgePagamento": "readonly",
    "filtrarEntradasPorPeriodo": "readonly",
    "filtrarSaidasPorPeriodo": "readonly",
    "entradasAntes": "readonly",
    "saidasAntes": "readonly",
    "somarValores": "readonly",
    "somarPorFormaPagamento": "readonly",
    "somarPorBancarios": "readonly",
    "calcularSaldo": "readonly",
    "calcularSaldoSeparado": "readonly",
    "agruparEntradasPorCurso": "readonly",
    "agruparSaidasPorCategoria": "readonly",
    "diasDoMes": "readonly",
    "inicioFimDoMes": "readonly",
    "OCREntradas": "readonly",
    "OCRSaidas": "readonly",
    "FirebaseManager": "readonly",
    "ModalManager": "readonly",
    "NavigationManager": "readonly",
    "EntradaPage": "readonly",
    "SaidaPage": "readonly",
    "RelatorioPage": "readonly",
    "TesourariaPage": "readonly",
    "DashboardPage": "readonly",
    "LoginPage": "readonly",
    "AuditoriaPage": "readonly",
    "BackupPage": "readonly",
    "IgrejaDropdown": "readonly",
    "AlunosManager": "readonly",
    "PickList": "readonly",
    "t": "readonly",
    "getLang": "readonly",
    "setLang": "readonly",
    "applyTranslations": "readonly"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "error",
    "no-console": "off",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-prototype-builtins": "off",
    "prefer-const": "warn",
    "no-var": "warn",
    "eqeqeq": ["warn", "smart"],
    "curly": ["warn", "multi-line"]
  },
  "ignorePatterns": ["node_modules/", "tests/", "sw.js", "*.min.js", "playwright.config.js"]
}
