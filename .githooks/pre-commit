#!/bin/sh
# IETEB — pre-commit hook
#
# 1) Roda os testes (npm test). Aborta o commit se algum falhar.
# 2) Bumpa automaticamente o cache-buster ?v=YYYYMMDDx no index.html
#    quando algum .js ou .css é modificado e o index.html ainda não
#    está staged (evita sobrescrever bump manual).
#
# Para pular tudo (ex.: commit de docs ou WIP), use:
#   git commit --no-verify -m "..."

# ── 1. Testes ────────────────────────────────────────────────────────
# Só roda se o package.json existir e o npm estiver disponível.
if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
  if [ -d node_modules ]; then
    if ! npm test --silent >/tmp/ieteb-test-out.log 2>&1; then
      echo "❌ pre-commit: testes falharam. Saída:"
      tail -50 /tmp/ieteb-test-out.log
      echo ""
      echo "   (use 'git commit --no-verify' para bypassar)"
      exit 1
    fi
  else
    echo "⚠ pre-commit: node_modules ausente — rodando 'npm install' primeiro?"
    echo "   (ou ignore com 'git commit --no-verify')"
    # Não aborta — primeira vez do clone pode não ter npm install ainda.
  fi
fi

# ── 2. Cache-buster ──────────────────────────────────────────────────
# Quais arquivos staged podem demandar bump?
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|css)$')

if [ -z "$CHANGED" ]; then
  exit 0
fi

# Se index.html já está staged, assumimos bump manual e não tocamos.
if git diff --cached --name-only | grep -qx 'index.html'; then
  exit 0
fi

if [ ! -f index.html ]; then
  exit 0
fi

# Versão atual: pega o primeiro v=YYYYMMDDx do index.html
CURRENT=$(grep -oE 'v=[0-9]{8}[a-z]' index.html | head -1 | sed 's/v=//')
if [ -z "$CURRENT" ]; then
  echo "pre-commit: cache-buster v=YYYYMMDDx não encontrado em index.html — pulando."
  exit 0
fi

DATE_PART=$(printf '%s' "$CURRENT" | cut -c 1-8)
LETTER=$(printf '%s' "$CURRENT" | cut -c 9)
TODAY=$(date +%Y%m%d)

if [ "$DATE_PART" = "$TODAY" ]; then
  if [ "$LETTER" = "z" ]; then
    echo "pre-commit: cache-buster do dia chegou em 'z' — bump manual necessário."
    exit 0
  fi
  NEXT_LETTER=$(printf '%s' "$LETTER" | tr 'a-y' 'b-z')
  NEW="${DATE_PART}${NEXT_LETTER}"
else
  NEW="${TODAY}a"
fi

# Substitui no index.html (compatível com BSD e GNU sed)
if sed --version >/dev/null 2>&1; then
  # GNU sed (Linux, Git Bash no Windows)
  sed -i "s/v=${CURRENT}/v=${NEW}/g" index.html
else
  # BSD sed (macOS)
  sed -i '' "s/v=${CURRENT}/v=${NEW}/g" index.html
fi

git add index.html

echo "pre-commit: cache-buster ${CURRENT} -> ${NEW}"
exit 0
